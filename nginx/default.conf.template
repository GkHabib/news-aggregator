# Rendered at container start by the nginx image (envsubst): ${API_KEY_*} come from `.env`.
# Keys stay server-side; the browser only calls /api/*. Mirrors the dev proxy in vite.config.ts.
server {
  listen 80;
  root /usr/share/nginx/html;
  index index.html;

  location /assets/ {
    expires 1y;
    add_header Cache-Control "public, immutable";
  }

  location /api/newsapi/ {
    proxy_pass https://newsapi.org/v2/;
    proxy_ssl_server_name on;
    proxy_set_header X-Api-Key "${API_KEY_NEWSAPI}";
  }

  location /api/guardian/ {
    # The original query string is appended after api-key.
    rewrite ^/api/guardian/(.*)$ /$1?api-key=${API_KEY_GUARDIAN} break;
    proxy_pass https://content.guardianapis.com;
    proxy_ssl_server_name on;
  }

  location /api/nytimes/ {
    rewrite ^/api/nytimes/(.*)$ /svc/search/v2/$1?api-key=${API_KEY_NYTIMES} break;
    proxy_pass https://api.nytimes.com;
    proxy_ssl_server_name on;
  }

  # SPA fallback
  location / {
    try_files $uri /index.html;
  }
}
